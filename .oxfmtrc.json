{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": ["src/routeTree.gen.ts", "worker-configuration.d.ts"],
	"jsxSingleQuote": true,
	"printWidth": 100,
	"quoteProps": "as-needed",
	"semi": false,
	"singleQuote": true,
	"sortImports": true,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true
}
