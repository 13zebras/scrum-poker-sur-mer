{
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "src/worker", "worker-configuration.d.ts"],
	"compilerOptions": {
		"target": "ES2023",
		"jsx": "react-jsx",
		"module": "ESNext",
		"paths": {
			"@/*": ["./src/*"]
		},
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node", "react", "react-dom", "vite/client", "vitest/globals"],
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noFallthroughCasesInSwitch": true
	}
}
