{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "scrum-poker",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	// Spending guardrails. Requests use under 100 ms CPU and at most 1 subrequest.
	"limits": { "cpu_ms": 1000, "subrequests": 20 },
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "scrumpoker.foo", "custom_domain": true },
		{ "pattern": "www.scrumpoker.foo", "custom_domain": true },
	],
	"durable_objects": {
		"bindings": [{ "name": "ROOMS", "class_name": "Room" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
}
